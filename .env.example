# Safe presentation defaults. Copy to .env.local, or run npm run admin:setup.
PREVIEW_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3107
# Optional server origin override, normally unset or identical to the public URL.
SITE_URL=
# PostgreSQL connection string required on Render, in preview and live mode.
DATABASE_URL=
# Enable only for remote PostgreSQL that requires verified TLS.
DATABASE_SSL=false
# Local development only. Never enabled on Render.
DB_MODE=pglite
LOCAL_DATABASE_PATH=.data/postgres
ADMIN_EMAIL=
# bcrypt cost >= 12. Generate with the private setup procedure; do not use plaintext here.
ADMIN_PASSWORD_HASH=
# Random secret, at least 32 characters. Rotation invalidates sessions.
SESSION_SECRET=
TRUST_PROXY=false
ALLOW_SAMPLE_DATA=false
# Optional Resend provider. All three fields are required to send notifications.
RESEND_API_KEY=
EMAIL_FROM=
LEAD_NOTIFICATION_EMAIL=
# Run npm run db:prune daily from an external scheduler or Render Cron Job.
ANALYTICS_RETENTION_DAYS=90
INQUIRY_RETENTION_DAYS=365
